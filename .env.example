# Copy to .env and fill in. Nothing here is needed to run the site locally —
# `npm run dev`, `npm run build` and `npm test` all work on a fresh clone with
# this file untouched. Each variable switches on one optional piece.
#
# .env is gitignored. Never commit real values: the API token below can write to
# your account's search index.

# The canonical origin, printed into canonical tags, the sitemap, llms.txt and
# the agent manifest. Falls back to the placeholder in astro.config.ts, which is
# a wrong answer everywhere it appears — set this before the first deploy.
#
# A real environment variable wins over this line, so CI can set it without a
# local .env overriding it. If neither is set, `npm run deploy` stops before
# uploading rather than publishing a site canonicalised to the placeholder —
# which is what it used to do, silently.
SITE_URL=https://docs.example.com

# --- Semantic retrieval (optional) -------------------------------------------
# Only read by scripts/index-sync.mjs, and only when `agents.retrieval` is
# 'ai-search' in src/docs.config.ts. The Worker itself never sees these: it
# reaches the index through the `AI_SEARCH` binding in wrangler.jsonc.
#
# The token is NOT the one wrangler holds. Create a separate one under
# AI → AI Search → Tokens with AI Search:Edit and AI Search:Run.
# See /agents/retrieval for creating the instance and choosing its settings.
CLOUDFLARE_ACCOUNT_ID=
AI_SEARCH_TOKEN=

# --- Issue reporting -----------------------------------------------------------
# Not read from here in production. `report_issue` reads its destination from
# the Worker's own FEEDBACK_WEBHOOK secret, set once with `wrangler secret put
# FEEDBACK_WEBHOOK` — never from docs.config.ts. See /reference/configuration#secrets
# for the full reasoning: the short version is that docs.config.ts is a
# template every fork starts from, and a literal webhook there would default
# every one of them to yours.
#
# The `report_issue` tool is hidden from every surface — MCP, HTTP, OpenAPI —
# until that secret is set, so agents are never offered a tool that would
# silently discard what they send.
#
# Do NOT name a key here FEEDBACK_WEBHOOK, even just as a personal reminder of
# what you set on Cloudflare. `wrangler dev` — and therefore `npm run dev` and
# `npm test`, which boot a real local Worker — auto-loads this file and merges
# any key here into `env`, the same object a Worker secret occupies at that
# name. A `FEEDBACK_WEBHOOK` line here does not stay inert: it makes
# `report_issue` appear configured locally, though it never affects what gets
# deployed, since `wrangler deploy` does not read this file at all. This is
# exactly how a real one went undetected, so this file uses a name Wrangler
# will never match to anything:
FEEDBACK_WEBHOOK_REFERENCE_ONLY=
