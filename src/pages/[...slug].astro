---
import { render, type CollectionEntry } from 'astro:content';
import DocsLayout from '../components/DocsLayout.astro';
import { mdxComponents } from '../components/mdx-components';
import { lastModifiedFor } from '../lib/last-modified';
import { getPageContext, hrefFor, isHomePage } from '../lib/navigation';
import { descriptionOf, getPublishedDocs } from '../lib/published';
import { getApiReference } from '../lib/openapi-reference';
import { buildStructuredData } from '../lib/structured-data';
import { seo as seoConfig, withBase } from '../docs.config';

export async function getStaticPaths() {
  const entries = await getPublishedDocs();
  /* Astro maps an undefined rest param to the site root. The configured
     homepage therefore never has to be named `index`. */
  return entries.map(entry => ({
    params: { slug: isHomePage(entry.id) ? undefined : entry.id },
    props: { entry },
  }));
}

interface Props { entry: CollectionEntry<'docs'> }
const { entry } = Astro.props;
const { Content, headings: rawHeadings } = await render(entry);

/* The page title is the layout's own h1, so a body `#` is a section. Imported
   Markdown often uses them for every section, and "On this page" then lost
   whole sections. When the body has any, the outline moves up a level: `#`
   lists as a section and `##` as its subsection. A page with no body `#` is
   unchanged. */
const shift = rawHeadings.some(heading => heading.depth === 1) ? 1 : 0;
const headings = rawHeadings
  .filter(heading => heading.depth >= 2 - shift && heading.depth <= 3 - shift)
  .map(heading => ({ id: heading.slug, label: heading.text, depth: (heading.depth + shift) as 2 | 3 }));

const api = entry.data.pageType === 'api-endpoint' ? getApiReference(entry.data) : undefined;

const context = await getPageContext(entry.id);

/* ── Search and social metadata ──────────────────────────────────────────────
   Derived here rather than declared per page. A page states its title and its
   description; everything a crawler or an assistant needs follows from those
   plus where the page sits in the navigation. */
const site = new URL(Astro.site!);
const canonical = new URL(hrefFor(entry.id), site).href;
const modified = lastModifiedFor(entry);
/* A frontmatter `image` is the author's string, prefix included — it may be a
   full URL. The generated cards are framework paths, so they carry the base. */
const image =
  entry.data.image ??
  (isHomePage(entry.id) ? withBase('/og.png') : withBase(`/og/${entry.id}.png`));

const seo = {
  canonical,
  noindex: entry.data.noindex,
  metaTitle: entry.data.metaTitle,
  image,
  imageAlt: entry.data.imageAlt,
  published: entry.data.published,
  modified,
  structuredData: entry.data.noindex
    ? undefined
    : buildStructuredData({
        origin: site,
        url: canonical,
        title: entry.data.title,
        description: descriptionOf(entry),
        /* The homepage belongs to the site, not to its first docs section. */
        tab: isHomePage(entry.id) ? undefined : context.activeTab,
        group: context.activeGroup,
        page: context.activePage,
        image: new URL(image, site).href,
        published: entry.data.published,
        modified,
        /* Widened: the config is `as const`, so its literal tuple type would
           otherwise reject any tab id that isn't already in the list. */
        /* An endpoint page is an API reference wherever it sits: a tab that
           mixes endpoints with guides and a FAQ would otherwise type the
           endpoints as articles. The tab list then adds the pages around them. */
        isApiReference: !isHomePage(entry.id) && (
          entry.data.pageType === 'api-endpoint' ||
          (seoConfig.apiReferenceTabs as readonly string[]).includes(context.activeTab.id)
        ),
      }),
};
---
<DocsLayout
  title={entry.data.title}
  description={descriptionOf(entry)}
  subtitle={entry.data.description ?? ''}
  headings={headings}
  api={api}
  rightRail={entry.data.rightRail}
  context={context}
  seo={seo}
>
  <div class="mdx-content"><Content components={mdxComponents} /></div>
</DocsLayout>
