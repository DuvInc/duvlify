---
/**
 * Turns the `theme` block of docs.config.ts into CSS custom properties. These
 * are the only brand-level tokens; the neutral palette and component styling
 * live in src/styles/tokens.css.
 *
 * Everything downstream reads var(--accent) / var(--font-sans) / var(--r-lg),
 * so changing the accent or the radius scale is a one-line edit in the config.
 *
 * The font family itself is not requested here — astro.config.ts hands the same
 * config to Astro's fonts API, which self-hosts the files and exposes the stack
 * as --font-brand. This only aliases it onto --font-sans.
 */
import { theme, type CornerSmoothing } from '../docs.config';

const { font, accent, headerPrimary, radius } = theme;

/** `theme.radius.smoothing` → the actual `corner-shape` value it stands for. */
const CORNER_SHAPE: Record<CornerSmoothing, string> = {
  none: 'round',
  subtle: 'superellipse(2)',
  standard: 'superellipse(3)',
  ios: 'squircle',
};

/** WCAG relative luminance of a `#rrggbb` string. */
function relativeLuminance(hex: string): number {
  const n = hex.replace('#', '');
  const [r, g, b] = [0, 2, 4].map((i) => parseInt(n.slice(i, i + 2), 16) / 255);
  const [R, G, B] = [r, g, b].map((c) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4));
  return 0.2126 * R + 0.7152 * G + 0.0722 * B;
}

/** WCAG contrast ratio between two `#rrggbb` colours. */
function contrastRatio(a: string, b: string): number {
  const [l1, l2] = [relativeLuminance(a), relativeLuminance(b)].sort((x, y) => y - x);
  return (l1 + 0.05) / (l2 + 0.05);
}

/**
 * The announcement strip's dark-mode fill and text colour, derived from
 * `accent.strongDark` rather than fixed to "white text on a dark tint".
 *
 * That fixed pairing is what `strongDark` is *for* everywhere else — it is
 * tuned to read as text against the dark page, which usually means a fairly
 * light colour. Used as a small swatch that is exactly what you want; used as
 * a full-bleed fill behind white text, the same lightness that makes it
 * legible as text makes white-on-it fail (a pale green measured 1.9:1 here
 * before this existed). A monochrome accent makes it worse: mixing a neutral
 * `strongDark` toward black just desaturates further, landing on a flat mid
 * grey with no hue to carry.
 *
 * So: use `strongDark` as the fill directly, unmixed, and pick whichever of
 * white or `accent.base` actually clears 4.5:1 against it — `accent.base` is
 * dark by construction (the same contract that makes it work as text on the
 * light-mode page), so it is the fallback that reads on a light fill.
 */
function bannerDarkTone(strongDark: string, base: string): { bg: string; fg: string } {
  const fg = contrastRatio('#ffffff', strongDark) >= contrastRatio(base, strongDark) ? '#ffffff' : base;
  return { bg: strongDark, fg };
}

/*
 * `accent.contrast` reaches the page through `--header-primary-fg` below rather
 * than as a token of its own. A standalone `--accent-contrast` was emitted here
 * and read by nothing: not one rule in src/styles, not one component, not one
 * page. It shipped in every page's inline <style> for no reader.
 */
const bannerDark = bannerDarkTone(accent.strongDark, accent.base);

const tokens = `
:root {
  --font-sans: var(${font.sansVariable}), ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-mono: ${font.mono};
  --accent: ${accent.base};
  --accent-strong: ${accent.strong};
  --header-primary-bg: ${headerPrimary.background || accent.base};
  --header-primary-fg: ${headerPrimary.foreground || accent.contrast};
  --r-lg: ${radius.lg};
  --r-md: ${radius.md};
  --r-sm: ${radius.sm};
  --r-xs: ${radius.xs};
  --corner-shape: ${CORNER_SHAPE[radius.smoothing]};
}
/* :root[data-theme="dark"], not the bare attribute selector tokens.css uses,
   so this always wins that tie regardless of which style tag the page
   happens to emit later — this one lost that race for --banner-info before
   the selector was bumped: same specificity, and tokens.css's bundle loads
   after this component's inline tag. */
:root[data-theme="dark"] {
  --accent-strong: ${accent.strongDark};
  --header-primary-bg: ${headerPrimary.backgroundDark || accent.strongDark};
  --header-primary-fg: ${headerPrimary.foregroundDark || accent.base};
  --banner-info: ${bannerDark.bg};
  --banner-info-fg: ${bannerDark.fg};
}
`.trim();
---
<style is:global set:html={tokens}></style>
