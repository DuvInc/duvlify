---
/**
 * One entry on a changelog timeline. The date and title form its permalink,
 * matching the Markdown heading advertised by the agent manifest. Including
 * the title also distinguishes releases published on the same day.
 */
import Badge from './Badge.astro';
import { slugify } from '../lib/slug';

interface Props {
  label?: string;
  title?: string;
  description?: string;
  tags?: string[];
}
const { label, title, description, tags = [] } = Astro.props;
const anchor = label || title ? slugify([label, title].filter(Boolean).join(': ')) : undefined;
// Published date-only links keep their original target after the anchor change.
const legacyAnchor = label && slugify(label) !== anchor ? slugify(label) : undefined;
---
<div class="update">
  <div class="update-rail">
    {label && (anchor
      ? <a class="update-label" id={legacyAnchor} href={`#${anchor}`}>{label}</a>
      : <span class="update-label">{label}</span>)}
  </div>
  <div class="update-content" id={anchor}>
    {title && <h3>{title}</h3>}
    {description && <p class="update-description">{description}</p>}
    {tags.length > 0 && (
      <div class="update-tags">{tags.map(tag => <Badge size="sm">{tag}</Badge>)}</div>
    )}
    <slot />
  </div>
</div>
