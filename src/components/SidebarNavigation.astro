---
/** Shared sidebar renderer for both navigation layouts. */
import Icon from './Icon.astro';
import type { NavigationMode } from '../docs.config';
import SidebarGroup from './SidebarGroup.astro';
import { sortBlocks, type GroupNode, type ResolvedGroup, type ResolvedTab } from '../lib/navigation';

interface Props {
  tabs: ResolvedTab[];
  activeTab: ResolvedTab;
  currentPath: string;
  mode: NavigationMode;
}

const { tabs, activeTab, currentPath, mode } = Astro.props;
const groups: ResolvedGroup[] = sortBlocks(
  mode === 'unified-sidebar' ? tabs.flatMap(tab => tab.groups) : activeTab.groups,
  mode === 'unified-sidebar',
);

/* The flat, depth-tagged list becomes a tree: each group nests in the nearest
   one above it with a smaller depth. */
const roots: GroupNode[] = [];
const stack: GroupNode[] = [];
for (const group of groups) {
  const node: GroupNode = { group, children: [] };
  while (stack.length && stack.at(-1)!.group.depth >= group.depth) stack.pop();
  (stack.length ? stack.at(-1)!.children : roots).push(node);
  stack.push(node);
}
---

{mode === 'category-tabs' && (
  <details class="category-switcher">
    <summary>
      <span><Icon name={activeTab.icon} size={17} />{activeTab.label}</span>
      <Icon name="chevronDown" size={16} />
    </summary>
    <div class="category-options">
      {tabs.map(tab => (
        <a class:list={[activeTab.id === tab.id && 'active']} href={tab.href}>
          <span><Icon name={tab.icon} size={17} />{tab.label}</span>
          {activeTab.id === tab.id && <Icon name="check" size={16} />}
        </a>
      ))}
    </div>
  </details>
)}

<nav aria-label="Documentation navigation">
  {roots.map(node => (
    <>
      {mode === 'unified-sidebar' && node.group.tabHeading !== undefined && (
        node.group.tabHeading
          ? <p class="nav-tab-heading">{node.group.tabHeading}</p>
          : <div class="nav-tab-spacer" aria-hidden="true"></div>
      )}
      <SidebarGroup node={node} currentPath={currentPath} />
    </>
  ))}
</nav>
