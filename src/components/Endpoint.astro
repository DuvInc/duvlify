---
interface Props {
  method?: string;
  path: string;
}
const { method = 'GET', path } = Astro.props;
const label = method.toUpperCase();
---
<p class="endpoint-row">
  <span class="api-method" data-method={label}><span class="api-method-label">{label}</span></span>
  <code class="endpoint">{path}</code>
</p>
