---
/**
 * A field of an OpenAPI schema, and every field nested under it.
 *
 * Recursive: a field with children renders one "Show child attributes"
 * disclosure, and each child renders this component again, at any depth the
 * model carries. The name shown is the full path (`data.fields.type`) with the
 * parent part muted, so two objects that both have an `id` read as two
 * different fields instead of two identical rows.
 */
import Icon from './Icon.astro';
import type { ApiSchemaField as FieldModel } from '../lib/openapi-reference';
import { renderSpecMarkdown } from '../lib/spec-markdown';

interface Props {
  field: FieldModel;
  /** The dotted path of the parent, empty at the top level. */
  parent?: string;
}
const { field, parent = '' } = Astro.props;

/* Descriptions come from the specification, where they are CommonMark — see
   lib/spec-markdown.ts. */
const description = await renderSpecMarkdown(field.description);
const path = parent ? `${parent}.${field.name}` : field.name;
---
<div class:list={['field', 'api-schema-field', parent && 'api-schema-child-field']}>
  <div class="field-head">
    <code class="field-name">{parent && <span class="field-path">{parent}.</span>}{field.name}</code>
    <span class="field-pill">{field.type}</span>
    {field.required && <span class="field-pill required">required</span>}
    {field.deprecated && <span class="field-pill deprecated">deprecated</span>}
    {field.constraints.map(constraint => <span class="field-pill" title={constraint.label}>{constraint.label}: {constraint.value}</span>)}
  </div>
  {description && <div class="field-content" set:html={description} />}
  {field.children.length > 0 && (
    <details class="expandable api-schema-children">
      <summary>
        <span class="disclosure-caret" aria-hidden="true"><Icon name="chevronRight" size={11} /></span>
        <span>Show child attributes</span>
      </summary>
      <div class="expandable-body">
        {field.children.map(child => <Astro.self field={child} parent={path} />)}
      </div>
    </details>
  )}
</div>
