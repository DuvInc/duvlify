# Editor and agent tooling. Local convenience, not part of the framework: nothing
# in the build reads it, and it carries machine-specific paths and ports that are
# wrong in anybody else's clone.
.claude/
.vscode/
.idea/

# Real values for .env.example. Holds an API token that can write to the
# account's search index, so it must never be committed.
.env
.env.*
!.env.example
